# Copy to .env (gitignored) and fill in. Required: the api, crawler and
# geoip-init services declare it as an env_file, so compose refuses to start
# without it.
#
# IPINFO_TOKEN — free IPinfo token, used by the geoip-init service to download
# the IPinfo Lite mmdb (country + ASN) into the geoip volume before the crawler
# starts. Get one at https://ipinfo.io/signup
IPINFO_TOKEN=

# The four compose tuning knobs, shown at their compose defaults. Uncomment to
# override; leaving them commented keeps compose's own `:-` fallbacks.
# These four are read by compose itself (replica count, volume path, build arg)
# via ${...} interpolation; every other key here is passed straight into the
# api/crawler/geoip-init containers.
#
# UNBOUND_DEV_PROFILE — which deploy/unbound/<profile>/ config the two resolvers
# mount. "dev" caps fan-out for OrbStack laptops; "dev-fast" uses prod fan-out.
# UNBOUND_DEV_PROFILE=dev
#
# FRONTEND_API_URL — host-visible API origin baked into the frontend bundle at
# build time.
# FRONTEND_API_URL=http://localhost:8080
#
# CRAWLER_REPLICAS — crawler processes (prod shape is 2; laptops default to 1).
# CRAWLER_REPLICAS=1
#
# CRAWLER_WORKER_SLOTS — per-process fan-out. 4 on laptops (OrbStack's 16k UDP
# conntrack limit); 64 on native-netfilter hosts.
# CRAWLER_WORKER_SLOTS=4

# TAILLIGHT_URL / TAILLIGHT_API_KEY — optional Taillight log shipping (09-ops
# §13). Read by the api/crawler/v6ctl binaries directly; the compose dev stack
# passes them into the containers via env_file. Production sets them in
# /etc/whynoipv6/env instead. Key needs the "ingest" scope:
# taillight apikey create --scope ingest
# TAILLIGHT_URL=https://taillight.example.com/api/v1/applog/ingest
# TAILLIGHT_API_KEY=
