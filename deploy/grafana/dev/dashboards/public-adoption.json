    },
    {
      "id": 17,
      "type": "table",
      "title": "Hosting and CDN league",
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 9
      },
      "description": "Adoption grouped by who serves the site. Apex is whether a AAAA exists, reachable is whether the site actually answers on it.",
      "datasource": {
        "type": "postgres",
        "uid": "whynoipv6-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT hosting_provider AS hosting, count(*) AS domains, round(100.0 * count(*) FILTER (WHERE base_status = 'supported') / nullif(count(base_status), 0), 1) AS \"apex v6 %\", round(100.0 * count(*) FILTER (WHERE conn_status = 'supported') / nullif(count(conn_status), 0), 1) AS \"reachable v6 %\" FROM domain WHERE NOT disabled AND hosting_provider IS NOT NULL GROUP BY 1 ORDER BY 2 DESC LIMIT 20"
        }
      ],
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*v6 %"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "min",
                "value": 0
              }
            ]
          }
        ]
      }
    },
