    {
      "id": 21,
      "type": "table",
      "title": "Hall of shame",
      "gridPos": {
        "x": 16,
        "y": 44,
        "w": 8,
        "h": 8
      },
      "description": "Hand picked offenders. Large, well resourced, and still without IPv6.",
      "datasource": {
        "type": "postgres",
        "uid": "whynoipv6-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT d.rank, d.host, t.reason FROM top_shame t JOIN domain d ON d.id = t.domain_id ORDER BY d.rank NULLS LAST LIMIT 25"
        }
      ],
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
