      "panels": []
    },
    {
      "id": 14,
      "type": "table",
      "title": "Network league",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 9
      },
      "description": "The networks hosting the most tracked domains. One large network turning IPv6 on moves the global number more than a thousand individual sites do.",
      "datasource": {
        "type": "postgres",
        "uid": "whynoipv6-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT a.number AS asn, a.name, a.count_total AS domains, a.count_v6 AS v6_domains, round(100.0 * a.count_v6 / nullif(a.count_total, 0), 1) AS \"v6 %\" FROM asn a WHERE a.count_total >= 100 AND a.name <> 'Unknown' ORDER BY a.count_total DESC LIMIT 30"
        }
      ],
      "options": {
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "v6 %"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "min",
                "value": 0
              }
            ]
          }
        ]
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Network adoption over time",
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 9
      },
      "description": "Apex IPv6 share for the ten networks holding the most tracked domains. Flat lines are the story here: these are the networks that could move the needle and mostly are not.",
      "datasource": {
        "type": "postgres",
        "uid": "whynoipv6-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(s.day, '1d') AS time, a.name AS metric, s.v6_domains::float / nullif(s.domains, 0) AS share FROM stats_asn_daily s JOIN asn a ON a.id = s.asn_id WHERE $__timeFilter(s.day) AND a.name <> 'Unknown' AND s.asn_id IN (SELECT asn_id FROM stats_asn_daily WHERE day = (SELECT max(day) FROM stats_asn_daily) AND asn_id IN (SELECT id FROM asn WHERE name <> 'Unknown') ORDER BY domains DESC LIMIT 10) ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": []
      }
    },
