        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "v6 %"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "unit",
                "value": "percent"
              },
              {
