        "uid": "whynoipv6-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT day::timestamptz AS time, base_supported, www_supported, ns_supported, mx_supported, conn_supported, resources_supported FROM stats_global_daily WHERE $__timeFilter(day::timestamptz) ORDER BY 1"
