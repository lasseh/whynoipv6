    {
      "id": 19,
      "type": "bargauge",
      "title": "Adoption by rank band",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 8,
        "h": 8
      },
      "description": "Cumulative apex IPv6 across the top N ranked sites. If popularity drove adoption this would slope downward. It does not.",
      "datasource": {
        "type": "postgres",
        "uid": "whynoipv6-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE rank <= 100 AND base_status = 'supported')::float / nullif(count(*) FILTER (WHERE rank <= 100 AND base_status IS NOT NULL), 0) AS \"top 100\", count(*) FILTER (WHERE rank <= 1000 AND base_status = 'supported')::float / nullif(count(*) FILTER (WHERE rank <= 1000 AND base_status IS NOT NULL), 0) AS \"top 1k\", count(*) FILTER (WHERE rank <= 10000 AND base_status = 'supported')::float / nullif(count(*) FILTER (WHERE rank <= 10000 AND base_status IS NOT NULL), 0) AS \"top 10k\", count(*) FILTER (WHERE rank <= 100000 AND base_status = 'supported')::float / nullif(count(*) FILTER (WHERE rank <= 100000 AND base_status IS NOT NULL), 0) AS \"top 100k\", count(*) FILTER (WHERE base_status = 'supported')::float / nullif(count(*) FILTER (WHERE base_status IS NOT NULL), 0) AS \"top 1M\" FROM domain WHERE rank IS NOT NULL AND NOT disabled"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1
        },
        "overrides": []
      }
    },
