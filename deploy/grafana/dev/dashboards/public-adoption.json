        "y": 52,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 23,
      "type": "stat",
      "title": "Reverse DNS on IPv6 hosts",
      "gridPos": {
        "x": 0,
        "y": 53,
        "w": 8,
        "h": 4
      },
      "description": "Of domains with IPv6 addresses, how many have reverse DNS configured for them.",
      "datasource": {
        "type": "postgres",
        "uid": "whynoipv6-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE ptr_observed IN ('supported', 'partial'))::float / nullif(count(*) FILTER (WHERE ptr_observed IN ('supported', 'partial', 'unsupported')), 0) AS share FROM domain WHERE base_status = 'supported' AND NOT disabled"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 24,
      "type": "stat",
      "title": "Mail that answers over IPv6",
      "gridPos": {
        "x": 8,
        "y": 53,
        "w": 8,
        "h": 4
      },
      "description": "Of domains whose mail servers publish IPv6 addresses, how many actually complete an SMTP handshake over IPv6.",
      "datasource": {
        "type": "postgres",
        "uid": "whynoipv6-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE smtp_observed = 'supported')::float / nullif(count(*) FILTER (WHERE smtp_observed IN ('supported', 'unsupported')), 0) AS share FROM domain WHERE mx_status = 'supported' AND NOT disabled"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 25,
      "type": "stat",
      "title": "Mail that only looks ready",
      "gridPos": {
        "x": 16,
        "y": 53,
        "w": 8,
        "h": 4
      },
      "description": "Mail servers publishing IPv6 addresses that refuse to actually talk over IPv6. Ready on paper, broken in practice.",
      "datasource": {
        "type": "postgres",
        "uid": "whynoipv6-pg"
