{
  "uid": "wni6-public",
  "title": "IPv6 Adoption, Live from Why No IPv6",
  "description": "PUBLIC DASHBOARD. This one is shared externally with no login, so treat every panel as published to the internet. Two rules for anything added here: it must describe the state of IPv6 rather than the state of our infrastructure, and it must never query the scan or scan_detail hypertables (an unauthenticated viewer can refresh at will, and those tables cost seconds per query). Aggregate tables, denormalised counters, and the domain table only. Sharing is configured in Grafana's database, not in this file: see docs/spec/09-ops.md section 12.1 to reproduce it.",
  "tags": [
    "public"
  ],
  "links": [],
  "timezone": "utc",
  "schemaVersion": 39,
  "refresh": "15m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "The state of IPv6",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Domains tracked",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "description": "Live domains on the list, taken from the top million ranked sites.",
      "datasource": {
        "type": "postgres",
        "uid": "whynoipv6-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS domains FROM domain WHERE NOT disabled"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Apex IPv6 adoption",
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "description": "Share of tracked domains publishing a AAAA record on the bare domain.",
      "datasource": {
        "type": "postgres",
        "uid": "whynoipv6-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE base_status = 'supported')::float / nullif(count(base_status), 0) AS adoption FROM domain WHERE NOT disabled"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
