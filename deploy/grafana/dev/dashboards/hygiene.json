{
  "uid": "wni6-hygiene",
  "title": "WhyNoIPv6 — Beyond AAAA (PTR & SMTP)",
  "description": "The informational dimensions collected on every scan but not shown on the site: reverse DNS on v6 addresses, and whether mail actually answers over IPv6. Neither ever gates classification.",
  "tags": [
    "whynoipv6",
    "data"
  ],
  "links": [
    {
      "type": "dashboards",
      "title": "Dashboards",
      "tags": [
        "whynoipv6"
      ],
      "asDropdown": true,
      "keepTime": false,
      "includeVars": false,
      "targetBlank": false,
      "icon": "external link",
      "tooltip": "",
      "url": ""
    }
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "type": "stat",
      "title": "PTR coverage (v6 hosts)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "description": "Domains whose apex AAAA addresses have reverse DNS, of those where the check produced a verdict. partial (some addresses) counts as covered.",
      "datasource": {
        "type": "postgres",
        "uid": "whynoipv6-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE ptr_observed IN ('supported', 'partial'))::float / nullif(count(*) FILTER (WHERE ptr_observed IN ('supported', 'partial', 'unsupported')), 0) AS share FROM domain WHERE base_status = 'supported' AND NOT disabled"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "SMTP answers over v6",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "description": "Of domains whose MX publishes AAAA, how many mail servers actually complete an SMTP handshake over IPv6.",
      "datasource": {
        "type": "postgres",
        "uid": "whynoipv6-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE smtp_observed = 'supported')::float / nullif(count(*) FILTER (WHERE smtp_observed IN ('supported', 'unsupported')), 0) AS share FROM domain WHERE mx_status = 'supported' AND NOT disabled"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Paper-v6 mail",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "description": "MX publishes AAAA but SMTP does not answer over IPv6 — mail that looks v6-ready on paper and is not.",
      "datasource": {
        "type": "postgres",
        "uid": "whynoipv6-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS paper FROM domain WHERE mx_status = 'supported' AND smtp_observed = 'unsupported' AND NOT disabled"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 1000,
                "color": "yellow"
              },
              {
                "value": 10000,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "SMTP over v6 by tier",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "description": "Working-SMTP share within each classification, among domains whose MX publishes AAAA. Sinners outscoring heroes is real: a sinner with v6 mail is usually parked on a large mail provider that did v6 for them.",
      "datasource": {
        "type": "postgres",
        "uid": "whynoipv6-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE classification = 'hero' AND smtp_observed = 'supported')::float / nullif(count(*) FILTER (WHERE classification = 'hero' AND smtp_observed IN ('supported', 'unsupported')), 0) AS hero, count(*) FILTER (WHERE classification = 'partial' AND smtp_observed = 'supported')::float / nullif(count(*) FILTER (WHERE classification = 'partial' AND smtp_observed IN ('supported', 'unsupported')), 0) AS partial, count(*) FILTER (WHERE classification = 'sinner' AND smtp_observed = 'supported')::float / nullif(count(*) FILTER (WHERE classification = 'sinner' AND smtp_observed IN ('supported', 'unsupported')), 0) AS sinner FROM domain WHERE mx_status = 'supported' AND NOT disabled"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "hero"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "partial"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sinner"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "piechart",
      "title": "SMTP over IPv6 (MX with AAAA)",
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "description": "Handshake outcomes for mail servers that advertise AAAA on their MX hosts.",
      "datasource": {
        "type": "postgres",
        "uid": "whynoipv6-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE smtp_observed = 'supported') AS answers, count(*) FILTER (WHERE smtp_observed = 'unsupported') AS refuses, count(*) FILTER (WHERE smtp_observed NOT IN ('supported', 'unsupported') OR smtp_observed IS NULL) AS untested FROM domain WHERE mx_status = 'supported' AND NOT disabled"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "answers"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "refuses"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "untested"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "bargauge",
      "title": "PTR verdicts (v6-enabled apexes)",
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "description": "Reverse-DNS state of apex AAAA addresses: full, partial (some addresses), or none.",
      "datasource": {
        "type": "postgres",
        "uid": "whynoipv6-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) FILTER (WHERE ptr_observed = 'supported') AS full, count(*) FILTER (WHERE ptr_observed = 'partial') AS partial, count(*) FILTER (WHERE ptr_observed = 'unsupported') AS none FROM domain WHERE base_status = 'supported' AND NOT disabled"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "full"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "partial"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "none"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Hygiene trends (share of scans per day)",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "description": "Daily supported-share of each informational check across all scans that produced a verdict. Scans the raw hypertable — keep the range modest.",
      "datasource": {
        "type": "postgres",
        "uid": "whynoipv6-pg"
      },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT $__timeGroup(ts, '1d') AS time, count(*) FILTER (WHERE ptr IN ('supported', 'partial'))::float / nullif(count(*) FILTER (WHERE ptr IN ('supported', 'partial', 'unsupported')), 0) AS ptr, count(*) FILTER (WHERE smtp = 'supported')::float / nullif(count(*) FILTER (WHERE smtp IN ('supported', 'unsupported')), 0) AS smtp FROM scan WHERE $__timeFilter(ts) GROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "decimals": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "gradientMode": "opacity",
            "showPoints": "never",
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ptr"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "smtp"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
